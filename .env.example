# Copy to .env. Generate each secret with: openssl rand -hex 32
POSTGRES_DB=bhai_garage
POSTGRES_USER=bhai_garage
POSTGRES_PASSWORD=replace_with_a_random_hex_value
SESSION_SECRET=replace_with_a_different_random_hex_value
BHAI_SETUP_TOKEN=replace_with_another_random_hex_value

# Start in safe simulation mode. Set to libvirt only after a host agent is connected.
BHAI_PROVISIONER=simulation
# Web binds to 127.0.0.1 only; use a TLS reverse proxy for public access.
BHAI_WEB_PORT=8080
BHAI_API_LOCAL_PORT=5000

# Optional host-agent Compose profile settings.
BHAI_AGENT_TOKEN=
BHAI_AGENT_UID=1000
BHAI_AGENT_GID=1000
# Replace using: stat -c %g /var/run/libvirt/libvirt-sock
LIBVIRT_GID=replace_with_numeric_socket_group_id
# Replace using: getent group libvirt-qemu | cut -d: -f3
BHAI_QEMU_GID=replace_with_numeric_qemu_group_id
BHAI_IMAGE_DIR=/var/lib/libvirt/images/bhai-garage-base
BHAI_VM_DIR=/var/lib/libvirt/images/bhai-garage-vms
BHAI_IMAGES_JSON=
BHAI_LIBVIRT_NETWORK=default
# Optional: set only after configuring a provider-compatible Linux bridge.
BHAI_LIBVIRT_BRIDGE=
BHAI_HOSTNAME=my-kvm-host
